    <TIER ANNOTATOR="kirakalyuzhnaya" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@aam2008f" PARTICIPANT="@aam2008f" TIER_ID="gestComment@aam2008f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a687" ANNOTATION_REF="a586">
                <ANNOTATION_VALUE>Внимание на мимике, не на всей голове</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a591" ANNOTATION_REF="a564">
                <ANNOTATION_VALUE>На уровне head выделено долгое отведение глаз в сторону</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a574" ANNOTATION_REF="a573">
                <ANNOTATION_VALUE>Здесь что-то между адаптором и прагматическим (кисти напрягаются вместе с повышением тона, выделяя часть с деепричастным оборотом, но в целом руки продолжают помогать снять стресс)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a695" ANNOTATION_REF="a594">
                <ANNOTATION_VALUE>Дополнение логического отрицания "нет" мотанием головы</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3222" ANNOTATION_REF="a709">
                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a603" ANNOTATION_REF="a600">
                <ANNOTATION_VALUE>Взгляд на интервьюера</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a607" ANNOTATION_REF="a604">
                <ANNOTATION_VALUE>Движение плечом, чтобы выделить фразу</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a725" ANNOTATION_REF="a630">
                <ANNOTATION_VALUE>поднимаются плечи</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a741" ANNOTATION_REF="a737">
                <ANNOTATION_VALUE>сброс напряжения</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a656" ANNOTATION_REF="a652">
                <ANNOTATION_VALUE>Чтобы уравновесить руки в пространстве, тело и голова двигаются в противоположную от рук сторону</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a662" ANNOTATION_REF="a657">
                <ANNOTATION_VALUE>переплетение пальцев</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3297" ANNOTATION_REF="a3290">
                <ANNOTATION_VALUE>мнёт пальцы</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3299" ANNOTATION_REF="a3295">
                <ANNOTATION_VALUE>коммуникативный жест заменяет фразу целиком</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3340" ANNOTATION_REF="a3320">
                <ANNOTATION_VALUE>Здесь отметила пальцы в прагматику, потому что, думаю, они помогают подобрать слово, обычно они - адаптеры</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3446" ANNOTATION_REF="a3439">
                <ANNOTATION_VALUE>убылка на слове "нравилось"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3458" ANNOTATION_REF="a3453">
                <ANNOTATION_VALUE>не стала размечать мимику на 02:36.230, думаю, это нервная неконтролируемая реакция</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3468" ANNOTATION_REF="a3464">
                <ANNOTATION_VALUE>улыбка на слове "добрые"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3497" ANNOTATION_REF="a3481">
                <ANNOTATION_VALUE>Прагматические и изобразительные жесты здесь иду отдновременно, временная граница условная</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3519" ANNOTATION_REF="a3516">
                <ANNOTATION_VALUE>кивки головой</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3561" ANNOTATION_REF="a3555">
                <ANNOTATION_VALUE>жест-бит</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3569" ANNOTATION_REF="a3566">
                <ANNOTATION_VALUE>неозвученный вопрос "представляешь, какой абсурд?"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3580" ANNOTATION_REF="a3576">
                <ANNOTATION_VALUE>опускает руку после жеста с зонтом</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3658" ANNOTATION_REF="a3650">
                <ANNOTATION_VALUE>идёт до конца фразы, здесь границы условные</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3735" ANNOTATION_REF="a3731">
                <ANNOTATION_VALUE>покачивание головы и торса из стороны в сторону, будто на весах или качелях</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3891" ANNOTATION_REF="a3885">
                <ANNOTATION_VALUE>разведение руками и пожимание лечами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3907" ANNOTATION_REF="a3892">
                <ANNOTATION_VALUE>разведение руками с указанием на себя</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3912" ANNOTATION_REF="a3905">
                <ANNOTATION_VALUE>мотание головой</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3933" ANNOTATION_REF="a3926">
                <ANNOTATION_VALUE>мотание головой</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4061" ANNOTATION_REF="a4055">
                <ANNOTATION_VALUE>здесь также возможна дейктическая интерпретация (возможно, здесь указание на себя как на эксперта в алгебре и комбинаторике, но я бы трактовала это как разделение прагматическое (алгебра чуть дальше от тела показывается, а комбинаторика ближе, чтобы "не смешивать" её пространственно с геометрией)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4202" ANNOTATION_REF="a4200">
                <ANNOTATION_VALUE>можно считать как прагматику и выделение головой слова "недавно", но мне кажется здесь играет больше боль дейктика, словно она чуть назад оборачивается в прошлое, говоря "недавно"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
